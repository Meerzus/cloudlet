{
  "name": "cloudlet-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "fixtures/*"
  ],
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.17.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "volta": {
    "node": "24.17.0",
    "npm": "11.12.1"
  },
  "scripts": {
    "build": "npm run build --workspace @cloudlet/toast",
    "build:lab": "npm run build --workspace @cloudlet/lab",
    "build:site": "npm run build --workspace @cloudlet/site",
    "dev": "npm run dev --workspace @cloudlet/lab",
    "dev:site": "npm run dev --workspace @cloudlet/site",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/toast/tsconfig.core.json --noEmit && tsc -p apps/site/tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tooling": "node --test tests/tooling/local-candidate.test.mjs tests/tooling/doc-coverage.test.mjs tests/tooling/release-notes.test.mjs",
    "check:docs": "node scripts/check-doc-examples.mjs && node scripts/check-doc-coverage.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "test:e2e": "playwright test",
    "check:package": "node scripts/check-package.mjs",
    "size": "npm run build && node scripts/measure-size.mjs",
    "size:baseline": "npm run build && node scripts/measure-size.mjs --write-baseline",
    "notices": "node scripts/generate-notices.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:package && node scripts/measure-size.mjs",
    "pack:local": "npm run build && node scripts/pack.mjs",
    "test:consumers": "node scripts/integration.mjs",
    "test:managers": "node scripts/package-managers.mjs",
    "registry:build": "node scripts/registry-build.mjs",
    "test:registry": "node scripts/registry-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "motion": "14.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
