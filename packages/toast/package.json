{
  "name": "@cloudlet/toast",
  "version": "1.2.0",
  "description": "Cloudlet notifications and async operations with an SSR-safe React renderer",
  "license": "MIT",
  "homepage": "https://cloudlet.dev/toaster",
  "repository": { "type": "git", "url": "git+https://github.com/Meerzus/cloudlet.git", "directory": "packages/toast" },
  "bugs": "https://github.com/Meerzus/cloudlet/issues",
  "keywords": ["react", "notifications", "toast", "snackbar", "accessibility", "async", "operations", "ssr"],
  "publishConfig": { "access": "public", "tag": "latest" },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "src/**/*.ts", "src/**/*.tsx", "LICENSE", "THIRD_PARTY_NOTICES.md", "README.md", "CHANGELOG.md"],
  "sideEffects": ["**/*.css"],
  "peerDependencies": { "react": "^18.2.0 || ^19.0.0", "react-dom": "^18.2.0 || ^19.0.0" },
  "scripts": { "build": "vite build && tsc -p tsconfig.build.json" }
}
